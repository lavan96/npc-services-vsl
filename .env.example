# ---------------------------------------------------------------------------
# VSL playback
# ---------------------------------------------------------------------------
# Master playlist for the adaptive ladder. This is the primary delivery path;
# everything else here is a fallback.
VITE_VSL_HLS_URL=

# Poster frame shown before the first video frame is decoded.
VITE_VSL_POSTER_URL=

# Single-file progressive MP4, used only when neither Media Source Extensions
# nor native HLS is available, or when every HLS recovery attempt has failed.
#
# This must be a small, streaming-sized encode — roughly 720p at 1.5 Mbps, with
# `-movflags +faststart`. `scripts/encode-vsl.mjs` emits a suitable file as
# `fallback-720p.mp4`. Do not point this at a mastering-quality export: the file
# it replaced was 6.3 GB (~83 Mbps), which guaranteed a stall for anyone who
# reached it. Leaving it empty is safer than setting it wrong.
VITE_VSL_FALLBACK_MP4_URL=

# Optional Apple-platform overrides. Leave empty to use the URLs above.
VITE_VSL_IOS_HLS_URL=
VITE_VSL_IOS_FALLBACK_MP4_URL=
